<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShellIcons</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>ShellIcons.Blazor</PackageId>
    <Description>Lucide-derived SVG icons for Blazor. Zero JS, zero CSS, tree-shakeable typed components.</Description>
    <Authors>shellui-dev</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;icons;svg;lucide;razor</PackageTags>
    <RepositoryUrl>https://github.com/shellui-dev/shell-icons</RepositoryUrl>
    <PackageProjectUrl>https://github.com/shellui-dev/shell-icons</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShellIcons.Generator\ShellIcons.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\catalog\lucide\icons\*.svg" />
    <AdditionalFiles Include="..\..\catalog\custom\icons\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\NOTICE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

</Project>
