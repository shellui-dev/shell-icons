<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <RootNamespace>ShellIcons</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>ShellIcons.Blazor</PackageId>
    <Description>Lucide-derived SVG icons for Blazor. Zero JS, zero CSS, tree-shakeable typed components auto-generated from the full 1,555-icon Lucide catalog.</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShellIcons.Generator\ShellIcons.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\catalog\lucide\icons\*.svg" />
    <AdditionalFiles Include="..\..\catalog\custom\icons\*.svg" />
  </ItemGroup>

</Project>
