<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ShellIcons.Avalonia</RootNamespace>
    <ShellIconsTarget>Avalonia</ShellIconsTarget>

    <IsPackable>true</IsPackable>
    <PackageId>ShellIcons.Avalonia</PackageId>
    <Description>Lucide-derived icons for Avalonia, drawn straight to the DrawingContext. Typed controls, an IconName enum dispatcher and tag/alias metadata — generated from the same 1,555-icon catalog as ShellIcons.Blazor, with no runtime SVG parsing.</Description>
    <PackageTags>avalonia;icons;svg;lucide;xaml;shellui</PackageTags>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShellIcons.Generator.Xaml\ShellIcons.Generator.Xaml.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The .json sidecars feed IconCatalog; ShellIconsTarget tells the generator which namespace to emit. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="ShellIconsTarget" />
    <AdditionalFiles Include="..\..\catalog\lucide\icons\*.svg;..\..\catalog\lucide\icons\*.json" />
    <AdditionalFiles Include="..\..\catalog\custom\icons\*.svg;..\..\catalog\custom\icons\*.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShellIcons.Avalonia.Tests" />
  </ItemGroup>

</Project>
