<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>ShellIcons.Docs</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ShellDocs.Tokens" Version="0.1.3-alpha" />
    <PackageReference Include="ShellDocs.Components" Version="0.1.3-alpha" />
    <PackageReference Include="ShellDocs.Core" Version="0.1.3-alpha" />
    <PackageReference Include="ShellDocs.Markdown" Version="0.1.3-alpha" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShellIcons.Blazor\ShellIcons.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="content/**/*.md;content/**/meta.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
